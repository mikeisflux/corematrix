# ---- ForeverComicCon configuration ----
# Most settings live in the database and are managed in /admin/settings
# (DivinityCoin keys, SendGrid, site name/URL, economy, security). Values
# here act as fallbacks when a setting is blank.

NEXT_PUBLIC_SITE_NAME=ForeverComicCon
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (libSQL). Local file for dev; Turso URL + token in production.
DATABASE_URL=file:./data/forevercomiccon.db
# DATABASE_AUTH_TOKEN=

SESSION_SECRET=change-me-to-a-long-random-string

# Optional bootstrap: these emails get admin when they create an account. Or run scripts/create-admin.ts.
ADMIN_EMAILS=you@example.com

# Payments go through DivinityCoin only. For local dev leave the key blank and
# turn on test mode: the checkout frame loads a local simulator that posts
# signed webhooks to our own endpoint.
DIVINITYCOIN_TEST_MODE=true
DIVINITYCOIN_WEBHOOK_SECRET=local-test-secret-change-me
# DIVINITYCOIN_API_URL=https://divinitycoin.com
# DIVINITYCOIN_API_KEY=sk_...
# DIVINITYCOIN_PARTNER_SLUG=forevercomiccon

# Email via SendGrid (receipts, password resets, digests). Blank key = messages are logged to the console (and
# recorded as failed in /admin/emails/logs). Sign-in links are shown in dev.
# SENDGRID_API_KEY=SG....
# MAIL_FROM=hello@forevercomiccon.com
# MAIL_FROM_NAME=ForeverComicCon
# INBOUND_EMAIL_KEY=   # Inbound Parse → /api/webhooks/sendgrid/inbound?key=<it>
# SENDGRID_EVENT_KEY=  # Event Webhook → /api/webhooks/sendgrid/events?key=<it>

# Cron protection (/api/cron/daily, /api/cron/weekly accept ?secret= or Bearer)
# CRON_SECRET=

# Economics (cents)
BASE_CLAIM_PRICE_CENTS=500
TAKEOVER_MULTIPLIER=1.25
SELLER_PREMIUM_SHARE=0.6
