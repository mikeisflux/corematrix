# ---- Towerline configuration ----
# Public
NEXT_PUBLIC_SITE_NAME=Towerline
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (libSQL). Local file for dev; Turso URL + token in production.
DATABASE_URL=file:./data/towerline.db
# DATABASE_AUTH_TOKEN=

# Secrets
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=you@example.com

# Payments. Leave STRIPE_SECRET_KEY empty to run in "sandbox" mode where
# checkout completes instantly without charging (for local dev and demos).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email (magic links + digests). Leave empty to print links to the server console.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Towerline <hello@yourdomain.com>

# Economics (cents)
BASE_CLAIM_PRICE_CENTS=500
TAKEOVER_MULTIPLIER=1.25
SELLER_PREMIUM_SHARE=0.6

# Cron protection. Set in production; /api/cron/daily and /api/cron/weekly accept ?secret= or a Bearer token.
# CRON_SECRET=
